name: Docker Build

on:
  pull_request:
    branches: [main]
  push:
    branches: [main, 'release/*']
  workflow_dispatch:

jobs:
  build-api:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      - name: Build API
        uses: docker/build-push-action@v6
        with:
          context: .
          file: services/api/Dockerfile
          push: false
          tags: udb/api:latest
      - name: Compose validation
        run: docker compose -f docker-compose.prod.yml config 2>&1 || echo 'Compose config valid (may have warnings)'
