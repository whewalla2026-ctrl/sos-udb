# UDB Environment Variables
# Copy this to .env and fill in your values

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/udb
DIRECT_URL=postgresql://user:password@localhost:5432/udb

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth ===
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRY=2h
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=24h

# === Firebase Auth ===
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_client_id
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# === AI Services ===
OPENAI_API_KEY=sk-your-openai-key
VERTEX_AI_MODEL=gemini-1.5-pro
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# === Pinecone (Vector DB) ===
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=udb-tutor

# === Blockchain ===
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=0x_your_private_key
SBT_CONTRACT_ADDRESS=0x_your_contract
POLYGON_CHAIN_ID=137

# === Storage ===
S3_BUCKET=udb-evidence
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=

# === Feature Flags ===
UNLEASH_URL=http://localhost:4242/api
UNLEASH_API_KEY=default:development.unleash-insecure-api-token

# === Monitoring ===
PROMETHEUS_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_SERVICE_NAME=udb-api
METRICS_PORT=9464

# === API ===
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3030
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3030,http://localhost:5173
APP_VERSION=1.0.0

# === TLS / Domain ===
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=admin@your-domain.com

# === Email / SMTP ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@udb.app
SMTP_SKIP_VERIFY=true

# === SMS / Notifications ===
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+15551234567
