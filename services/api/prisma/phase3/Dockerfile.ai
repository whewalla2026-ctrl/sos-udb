FROM node:20-slim AS builder
WORKDIR /app
COPY services/api/prisma/phase3/package.json services/api/prisma/phase3/package-lock.json ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev
COPY services/api/prisma/phase3/ ./

FROM node:20-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y curl --no-install-recommends && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
COPY --from=builder /app ./
RUN useradd -m -d /app -s /bin/bash -u 1001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3003/ai/health || exit 1
CMD ["node", "services/ai-service.js"]
