FROM node:20-alpine
WORKDIR /app
RUN apk add --no-cache curl
COPY package*.json ./
RUN npm install --production
COPY services/api/prisma/ ./
ENV NODE_PATH=/app/node_modules
EXPOSE 3004
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3004/monitoring/health || exit 1
CMD ["node", "phase3/services/monitoring-service.js"]
