{
  "name": "udb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Developmental Backbone (UDB) — Ages 6-23",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start:api": "pnpm --filter @udb/api start",
    "start:web": "pnpm --filter @udb/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "pnpm --filter @udb/api test",
    "test:web": "pnpm --filter @udb/web test",
    "test:e2e:api": "pnpm --filter @udb/api test:e2e",
    "test:e2e:web": "pnpm --filter @udb/web test:e2e",
    "test:e2e:phase2:db": "pnpm --filter @udb/api exec jest --config ./services/api/test/jest-e2e-phase2.json ./services/api/test/e2e-phase2-db.e2e-spec.ts",
    "test:e2e:phase2:graphql": "pnpm --filter @udb/api exec jest --config ./services/api/test/jest-e2e-phase2.json ./services/api/test/e2e-phase2-graphql.e2e-spec.ts",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "db:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "db:dev-down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "clean": "pnpm -r exec -- rm -rf dist .next node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
