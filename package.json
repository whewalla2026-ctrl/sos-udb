{
  "name": "udb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Developmental Backbone (UDB) — Ages 6-23",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start:api": "pnpm --filter @udb/api start",
    "start:web": "pnpm --filter @udb/web start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "db:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "db:dev-down": "docker-compose -f docker-compose.dev.yml down",
    "test:e2e:phase2:db": "pnpm --filter @udb/api exec jest --config ./services/api/test/jest-e2e-phase2.json ./services/api/test/e2e-phase2-db.spec.ts",
    "test:e2e:phase2:graphql": "pnpm --filter @udb/api exec jest --config ./services/api/test/jest-e2e-phase2.json ./services/api/test/e2e-phase2-graphql.spec.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
