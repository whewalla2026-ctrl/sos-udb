{
  "name": "udb-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -w mumps build || true",
    "start:api": "node ./services/api/dist/main.js",
    "start:web": "node ./apps/web/.next/scala.js",
    "test": "jest",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init --preview-feature"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "prisma": "^4.0.0",
    "@prisma/client": "^4.0.0"
  }
}
