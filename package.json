{
  "name": "udb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Developmental Backbone (UDB) — Ages 6-23",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start:api": "pnpm --filter @udb/api start",
    "start:web": "pnpm --filter @udb/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "db:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "db:dev-down": "docker-compose -f docker-compose.dev.yml down",
    "test:e2e:phase2:db": "pnpm --filter @udb/api exec jest --config ./services/api/test/jest-e2e-phase2.json ./services/api/test/e2e-phase2-db.e2e-spec.ts",
    "test:e2e:phase2:graphql": "pnpm --filter @udb/api exec jest --config ./services/api/test/jest-e2e-phase2.json ./services/api/test/e2e-phase2-graphql.e2e-spec.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/instrumentation-ioredis": "^0.65.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "^5.22.0",
    "autocannon": "^8.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3"
  }
}
