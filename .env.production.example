# Production Environment Variables
# COPY THIS FILE TO .env.production AND FILL IN ALL VALUES

# === Authentication ===
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_256BIT_SECRET
JWT_EXPIRY=15m

# === Database (PostgreSQL) ===
# Generate strong random password (24+ chars, alphanumeric)
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=udb
DB_USER=udb
DATABASE_URL=postgresql://udb:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# === Redis ===
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# === Grafana ===
# Generate strong admin password (16+ chars)
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# === Backup Encryption ===
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_STRONG_PASSPHRASE

# === Application ===
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# STRIPE_SECRET_KEY=sk_live_...  # Optional: for escrow payments
