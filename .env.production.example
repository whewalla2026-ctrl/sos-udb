# Production Environment Variables
# COPY THIS FILE TO .env AND FILL IN VALUES

# JWT - Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_256BIT_SECRET

# Database - Generate strong random password (24+ chars)
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Firebase (Optional - JWT works without this)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# Other production secrets
# STRIPE_SECRET_KEY=sk_live_...
# JWT_EXPIRY=15m
# NODE_ENV=production
# === Backup Encryption ===
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_STRONG_PASSPHRASE
